{
  "manifest_version": 3,
  "name": "CaptionSense",
  "description": "Hover subtitle words on YouTube, Netflix, and JioHotstar to see quick meanings without leaving the video.",
  "version": "0.2.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "*://*.jiohotstar.com/*",
    "*://*.hotstar.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CaptionSense",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.jiohotstar.com/*",
        "*://*.hotstar.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
